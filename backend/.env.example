# Sao chép file này thành .env rồi sửa giá trị.

# Khoá ký JWT. Bắt buộc đổi trước khi chạy thật.
# Sinh khoá mới: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-chay-that

# Chuỗi kết nối cơ sở dữ liệu. Mặc định là SQLite trong thư mục data/.
# Đổi sang MySQL:      mysql+pymysql://user:pass@127.0.0.1:3306/project200
# Đổi sang PostgreSQL: postgresql+psycopg://user:pass@127.0.0.1:5432/project200
DATABASE_URL=sqlite:///data/project200.db

# Cổng của backend. Chọn 8421 để không đụng các project khác trong máy.
HOST=127.0.0.1
PORT=8421

DEBUG=false

# Danh sách origin của frontend, ngăn cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
