# Sao chép file này thành .env rồi sửa giá trị.

# Khoá ký JWT. Bắt buộc đổi trước khi chạy thật.
# Sinh khoá mới: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-chay-that

# Chuỗi kết nối cơ sở dữ liệu. Mặc định là SQLite trong thư mục data/.
# Đổi sang MySQL:      mysql+pymysql://user:pass@127.0.0.1:3306/nen_tang_project
# Đổi sang PostgreSQL: postgresql+psycopg://user:pass@127.0.0.1:5432/nen_tang_project
DATABASE_URL=sqlite:///data/nen-tang-project.db

# Cổng của backend. Chọn 8421 để không đụng các project khác trong máy.
HOST=127.0.0.1
PORT=8421

DEBUG=false

# Thư mục frontend, tính từ thư mục backend. Backend phục vụ luôn thư mục này,
# nhờ vậy giao diện và API chạy trên cùng một cổng. Để trống thì backend chỉ
# phục vụ API và địa chỉ gốc chuyển hướng sang trang tài liệu API.
FRONTEND_DIR=../frontend

# Danh sách origin của frontend, ngăn cách bằng dấu phẩy. Chỉ cần tới khi chạy
# giao diện trên một cổng riêng; chạy chung một cổng thì không dùng tới.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000
